	<parameter name="artista" class="java.lang.String" nestedType="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT artists."Name" AS "Name-A",
	albums."Title",
	tracks."Name" AS "Name-T",
	tracks."AlbumId" AS "AlbumId-T",
	albums."AlbumId" AS "AlbumId-A",
	albums."ArtistId" AS "ArtistId-Al",
	artists."ArtistId" AS "ArtistId-Ar"
FROM artists
	INNER JOIN albums ON 
	 albums."ArtistId" = artists."ArtistId" 
	INNER JOIN tracks ON 
	 albums."AlbumId" = tracks."AlbumId" 
WHERE 
	 "ArtistId-Ar" = $P{artista}]]>
	</queryString>
